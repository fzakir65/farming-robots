Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 2
      Plane Cell Count: 40
      Offset:
        X: 32
        Y: 30
        Z: 0
    - Class: rviz_default_plugins/MarkerArray
      Name: Farm
      Enabled: true
      Topic:
        Value: /farm/markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: Robot frames
      Enabled: true
      Show Names: false
      Marker Scale: 2
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 95
      Focal Point:
        X: 32
        Y: 30
        Z: 0
      Pitch: 1.0
      Yaw: 4.71
Window Geometry:
  Width: 1200
  Height: 800
